# Sander Kleinenberg archive — a private work-in-progress, not part of the blog.
#
# Keep it out of search engines. Same reasoning as tr/.htaccess: send the
# header rather than disallowing the path in robots.txt, because a disallowed
# path can never be crawled to SEE a noindex, and a URL discovered some other
# way can still surface with no title. Allow the crawl, tag every response.
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
</IfModule>

# ---- password ------------------------------------------------------------
# index.php asks for it and serves nothing without it. The hash sits in
# auth.php, which is not in this repository -- the repository is public. See
# the note at the top of index.php.
#
# It is done in PHP rather than here because AuthUserFile wants an ABSOLUTE
# server path, which differs depending on whether this domain is the main one
# or an add-on under another subscription, and a wrong path returns 500 for
# the whole folder. PHP needs no such path and cannot take the folder down.
#
# Some PHP-FPM setups drop the Authorization header before PHP sees it, so
# hand it over explicitly.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

# The pictures under pics/ are handed out by Apache, not by index.php, so
# somebody who knows an exact filename still gets one. To shut that too, use
# Plesk: Websites & domeinen -> timvanheukelom.nl -> Wachtwoordbeveiligde
# mappen -> map "/5k" toevoegen. It writes the auth config itself and cannot
# break the directory. If you turn it on, take the gate out of index.php as
# well, or the page asks twice.

# The key file prints nothing of its own, but it is not meant to be fetched.
<Files "auth.php">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>
