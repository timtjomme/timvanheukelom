# timvanheukelom.nl — static site (replaces the WordPress install)
#
# NOTE: this file is Apache-only. If the host serves this domain through nginx,
# none of it applies — see README ("Deploying") for the nginx equivalents, and
# in particular move comments/data out of the web root, because the
# Require-all-denied rules below are what protect it on Apache.

DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ---- old WordPress permalinks -------------------------------------------
  # Every published link, bookmark and search result points at a directory
  # (/landen/nobus/), but the static build is files (/landen/nobus.html).
  # Without these the whole site 404s the moment WordPress is switched off.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(landen|voorbereidingen)/([^/]+)/?$ /$1/$2.html [R=301,L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(travelblog|timtjomme|waar-zijn-we-geweest)/?$ /$1.html [R=301,L]

  # The Polarsteps map now lives on the "waar zijn we geweest" page alongside
  # the travelmap one, so /polarsteps has no page of its own any more. It was
  # a published URL, so it redirects rather than 404s. No !-f guard here on
  # purpose: polarsteps.html is gone and must stay gone.
  RewriteRule ^polarsteps(\.html|/)?$ /waar-zijn-we-geweest.html [R=301,L]

  # The 360 viewer pages were never mirrored — send them to the story index
  # rather than leaving a dead end.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^cardboard/[0-9]+/?$ /travelblog.html [R=302,L]
</IfModule>

# ---- leftovers from WordPress ---------------------------------------------
# If any wp-* files survive the switchover they should not be reachable.
<FilesMatch "^(wp-config\.php|wp-login\.php|xmlrpc\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# ---- caching ---------------------------------------------------------------
# Photos and fonts never change once published. HTML must not be pinned, or a
# new story would not show up for repeat visitors. site.css and the scripts
# keep their filenames when they are edited, so they get a short life rather
# than a version query string that would have to be bumped by hand in 21
# files; they are 25 KB together, so re-fetching them costs nothing.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType text/css                "access plus 1 hour"
  ExpiresByType application/javascript  "access plus 1 hour"
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
